{
  "info": {
    "name": "Lab 4 - Secure Connect and Communication Platform",
    "description": "Postman Collection for Web Dev III Unit 4 Lab Practicals: Authentication, JWT, Protected Notes, RBAC, and Real-Time Socket.IO communication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "jwtToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "noteId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Signup User (bcrypt hash)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_alex\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Signup Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_yug\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminSecret999!\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Login User (Returns JWT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Secure Notes API",
      "item": [
        {
          "name": "Get Notes WITHOUT Token (Blocked 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Create Note WITH JWT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Confidential Security Study\",\n  \"content\": \"JWT tokens provide stateless identity verification across microservices.\",\n  \"tags\": [\"security\", \"jwt\", \"node\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Get All User Notes (Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Confidential Security Study (Updated)\",\n  \"content\": \"Updated with Socket.IO bidirectional real-time communication details.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notes/{{noteId}}", "host": ["{{baseUrl}}"], "path": ["api", "notes", "{{noteId}}"] }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notes/{{noteId}}", "host": ["{{baseUrl}}"], "path": ["api", "notes", "{{noteId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. RBAC & Protected Routes",
      "item": [
        {
          "name": "Get Protected Profile (User or Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/protected/profile", "host": ["{{baseUrl}}"], "path": ["api", "protected", "profile"] }
          }
        },
        {
          "name": "Admin Dashboard (Forbidden 403 for Standard User)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/protected/admin-dashboard", "host": ["{{baseUrl}}"], "path": ["api", "protected", "admin-dashboard"] }
          }
        },
        {
          "name": "Admin Dashboard (Allowed 200 for Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/protected/admin-dashboard", "host": ["{{baseUrl}}"], "path": ["api", "protected", "admin-dashboard"] }
          }
        },
        {
          "name": "Get EventEmitter Event Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/protected/events", "host": ["{{baseUrl}}"], "path": ["api", "protected", "events"] }
          }
        }
      ]
    }
  ]
}
